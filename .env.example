# ============================================================
# 独立后端服务环境变量（server/index.ts 读取）
# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 忽略
# ============================================================

# 服务端口：
#   生产 `npm run start` 默认 9111（同时托管静态资源 + API）；
#   开发 `npm run server`（dev:all 中的 api）默认 9112，由 vite 代理转发。
#   可用 PORT 覆盖；本机约定端口 9111，勿占用 3000。
PORT=9111

# 数据库文件位置（node:sqlite，默认 data/app.db；首次启动自动建表并从旧 JSON 迁移）
DB_PATH=data/app.db

# 鉴权开关：
#   false（默认）= 本机免密，后台页可直接进入、保存、查看线索（保持现状）
#   true  = 部署到公网时启用，后台保存/查看线索、上传需要登录会话
AUTH_ENABLED=false

# 后台登录密码（仅 AUTH_ENABLED=true 时生效；公网务必改成强密码）
ADMIN_PASSWORD=gaoxiang2026

# 会话 Cookie / JWT 签名密钥（仅 AUTH_ENABLED=true 时生效，公网务必改成随机长串）
JWT_SECRET=dev-insecure-secret-change-me
SESSION_SECRET=dev-insecure-secret-change-me

# 反向代理信任（如经 nginx / 云网关，设为 true 才信任 X-Forwarded-For 解析真实 IP；否则限流按 socket IP）
TRUST_PROXY=false

# 接单线索公开提交：单 IP 每分钟上限（防刷）
LEADS_MAX_PER_MIN=10

# 线索即时通知：配置后，每次新线索会以 POST JSON 推送到该地址（如飞书/企业微信/Telegram Webhook）
# 留空则关闭通知。非阻塞、5s 超时，不影响提交体验。
NOTIFY_WEBHOOK_URL=

# CORS 允许的来源，逗号分隔。默认 *（本机/开发）；
# 部署时填真实域名，例如：https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*
