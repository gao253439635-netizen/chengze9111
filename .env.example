# 后台管理密码（/admin 登录用）。请改成你自己的，不要用真实重要密码。
ADMIN_PASSWORD=your-strong-password-here

# 是否启用后台密码认证
# false = 本机免密直接进入后台
# true  = 需要输入密码，部署到公网务必设为 true
AUTH_ENABLED=true

# 会话密钥（AUTH_ENABLED=true 时必须设置，改为随机字符串）
JWT_SECRET=change-this-to-a-random-string
SESSION_SECRET=change-this-to-another-random-string

# 数据库路径
DB_PATH=data/app.db

# CORS 允许的来源，逗号分隔；部署时填真实域名
CORS_ORIGINS=*

# 反向代理（如经 nginx/云网关，设为 true）
TRUST_PROXY=false
